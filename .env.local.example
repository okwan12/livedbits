# Copy this file to .env.local and fill in your own values.
# .env.local is already git-ignored, so your keys won't get committed.

# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Also from Supabase: Project Settings > API > service_role secret.
# ONLY used by scripts/bulk-upload.js, which runs on your machine, not in
# the browser. Never prefix this with NEXT_PUBLIC_, and never commit it —
# it has full admin access to your database and storage.
SUPABASE_SERVICE_ROLE_KEY=

# From Mapbox: Account > Tokens (the default public token works fine)
NEXT_PUBLIC_MAPBOX_TOKEN=
